<Project Sdk="Microsoft.NET.Sdk">

  <!-- A .NET Framework 4.8 console that shows interop in both directions:
       it calls the legacy WCF service over SOAP and the modern ASP.NET Core API over REST/JSON. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SkirtPling.Legacy.NetFrameworkClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <!-- Reuses the service contract source file instead of a generated proxy: both sides are .NET Framework. -->
  <ItemGroup>
    <Compile Include="..\WcfService\IWarehouseService.cs" Link="IWarehouseService.cs" />
  </ItemGroup>

</Project>
