<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 on purpose: this stands in for the old warehouse system. It builds anywhere
       (via reference assemblies) but hosting WCF needs Windows with .NET Framework 4.8 installed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SkirtPling.Legacy.WcfService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
